.vs/
.vscode/
.idea/
*.DotSettings.user
/[Aa]ssets/Plugins/Editor/JetBrains*

# Gradle cache directory
.gradle/

# Crash reports and build output
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.app
*.unitypackage
